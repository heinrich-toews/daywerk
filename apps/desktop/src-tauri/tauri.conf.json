{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daywerk",
  "version": "0.1.0",
  "identifier": "de.twxsoft.daywerk",
  "build": {
    "beforeDevCommand": "pnpm --filter web-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter web-ui build",
    "frontendDist": "../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Daywerk",
        "width": 420,
        "height": 880,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
