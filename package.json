{
  "name": "daywerk",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "pnpm --filter web-ui dev",
    "build": "pnpm --filter web-ui build",
    "server": "cargo run -p dw-server",
    "test": "cargo test --workspace && pnpm --filter web-ui test",
    "test:ui": "pnpm --filter web-ui test",
    "test:api": "python3 scripts/api-smoke.py",
    "desktop:dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config apps/desktop/src-tauri/tauri.conf.json",
    "android:init": "scripts/android.sh init",
    "android:dev": "scripts/android.sh dev",
    "android:build": "scripts/android.sh build",
    "android:build:debug": "scripts/android.sh build --debug --apk",
    "android:emulator": "scripts/emulator.sh"
  }
}
